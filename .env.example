# Copy to .env and fill private values; never commit .env.
ROOMIX_DB_PASSWORD=
ROOMIX_JWT_SECRET=
# Same private value for Core and Face; at least 32 UTF-8 bytes.
FACE_SERVICE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORE_TELEGRAM_WORKER_ENABLED=false
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax

# Optional: without a key the RAG service runs in mock mode.
GEMINI_API_KEY=

# Optional: required only for uploading room images to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail App Password for password-reset emails. Never commit real credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRATION_MINUTES=15

# VNPAY sandbox merchant credentials. Configure IPN URL in VNPAY's merchant portal:
# https://your-public-domain/api/invoices/vnpay/ipn (public HTTPS, not localhost).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:18080/api/invoices/vnpay/return

# Host ports. The containers still use 8080-8084 and PostgreSQL 5432 internally.
GATEWAY_HOST_PORT=18080
CORE_HOST_PORT=18081
RENTAL_HOST_PORT=18082
RAG_HOST_PORT=18083
FACE_HOST_PORT=18084
CORE_DB_HOST_PORT=15432
RENTAL_DB_HOST_PORT=15433

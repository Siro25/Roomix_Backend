# Local launcher loads this file; Spring Boot alone does not.
CORE_PORT=8081
CORE_DB_URL=jdbc:postgresql://localhost:15432/core_db
CORE_DB_USERNAME=postgres
CORE_DB_PASSWORD=
# Same team secret: Base64 encoding of at least 32 random bytes.
JWT_SECRET=
JWT_ISSUER=roomix-core
JWT_EXPIRATION_SECONDS=3600
# Must match Face Python, at least 32 UTF-8 bytes.
FACE_SERVICE_TOKEN=
# Leave empty when CORS is handled by Gateway.
CORE_ALLOWED_ORIGINS=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Core text notifications only. Photos are handled by Face Python.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORE_TELEGRAM_WORKER_ENABLED=false

# Main account recovery and HttpOnly refresh cookie settings (optional).
REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Spring Boot khong tu nap file .env. Truyen qua terminal/IDE/Docker Compose.
CORE_PORT=8081
CORE_DB_URL=jdbc:postgresql://localhost:15432/core_db
CORE_DB_USERNAME=postgres
CORE_DB_PASSWORD=
# Cung gia tri ROOMIX_JWT_SECRET cua nhom; khac FACE_SERVICE_TOKEN.
JWT_SECRET=
CORE_JWT_ISSUER=roomix-core
CORE_JWT_TTL_SECONDS=900
# Bat buoc, cung gia tri FACE_SERVICE_TOKEN trong Face Python; it nhat 32 byte.
FACE_SERVICE_TOKEN=
# Chi bat always cho database Core moi sau khi kiem tra schema.
CORE_DB_INIT_MODE=never
# Bo trong khi CORS do Gateway quan ly. Dat origin ro rang neu goi Core truc tiep.
CORE_ALLOWED_ORIGINS=
# Chi bat 1 lan de tao Admin dau tien, sau do tat va xoa mat khau khoi cau hinh.
CORE_BOOTSTRAP_ADMIN=false
CORE_ADMIN_USERNAME=
CORE_ADMIN_PASSWORD=
CORE_ADMIN_EMAIL=
CORE_ADMIN_FULL_NAME=
# Bo trong ca hai de tat Telegram chu trong Core. Anh van do Face Python gui.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORE_TELEGRAM_WORKER_ENABLED=true

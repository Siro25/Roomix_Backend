# Core Java phải triển khai hợp đồng trong docs/CORE_INTEGRATION.md.
CORE_URL=http://localhost:8081
# Cùng giá trị với cấu hình xác thực nội bộ bên Core; dùng bí mật ngẫu nhiên.
FACE_SERVICE_TOKEN=
# Database riêng của Face, không dùng database Core.
FACE_DATABASE_URL=postgresql://face_user:CHANGE_ME@localhost:5432/roomix_face
# Bỏ trống để tắt Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chỉ bật công cụ thử camera cục bộ khi cần. Mặc định false.
FACE_ENABLE_DEMO=false

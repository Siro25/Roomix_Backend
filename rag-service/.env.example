# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Service Configuration
SERVICE_PORT=8083
SERVICE_HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Vector DB
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Room data source (core-service). Leave empty to disable syncing.
CORE_SERVICE_URL=http://localhost:8081
CORE_SYNC_INTERVAL_SECONDS=300
# Demo rooms, only used when CORE_SERVICE_URL is empty
SEED_SAMPLE_ROOMS=false
